EVALUATE
SUMMARIZECOLUMNS (
    dim_facility[facility_id],
    "Avg Dock Wait (h)", [Avg Dock Wait (h)],
    "Dock-Delayed Late Trips", [Dock-Delayed Late Trips],
    "Late Trip Dock Wait (h)", CALCULATE ( [Avg Dock Wait (h)], fact_trip[is_dock_delayed] = TRUE (), fact_trip[on_time] = FALSE () ),
    "Trips", [Trips]
)
ORDER BY dim_facility[facility_id]
