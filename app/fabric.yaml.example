# Copy to fabric.yaml (gitignored), or run:
#   npx fabric-app-data add semanticModel ambermoor --workspace <WS_AMBERMOOR_DEV_ID> --item <SM_AMBERMOOR_OPS_ID>
activeProfile: default
profiles:
  default:
    semanticModels:
      ambermoor:
        workspaceId: <WS_AMBERMOOR_DEV_ID>
        itemId: <SM_AMBERMOOR_OPS_ID>
